ROUTEOPS_ENV=development
ROUTEOPS_LOG_LEVEL=INFO
# Use the same locally chosen password as POSTGRES_PASSWORD. URL-encode it here.
# Format: postgresql+psycopg://<user>:<encoded-password>@database:5432/<db>
ROUTEOPS_DATABASE_URL=
ROUTEOPS_VROOM_URL=http://vroom:3000
ROUTEOPS_OSRM_URL=http://osrm:5000
ROUTEOPS_SOLVER_TIMEOUT_SECONDS=15
ROUTEOPS_HTTP_CONNECT_TIMEOUT_SECONDS=2
ROUTEOPS_HTTP_READ_TIMEOUT_SECONDS=20
ROUTEOPS_CORS_ORIGINS=http://localhost:5173
ROUTEOPS_MAP_DATASET_SHA256=22230c1c093a0fe50bbb240cce3d2c36aaf34e8bfb2fe136b76405084de213c4
ROUTEOPS_IMPORT_RETENTION_DAYS=30
ROUTEOPS_IMPORT_MAX_FILE_BYTES=20971520
ROUTEOPS_IMPORT_MAX_PACKAGE_BYTES=104857600
ROUTEOPS_IMPORT_ORPHAN_GRACE_SECONDS=3600
ROUTEOPS_IMPORT_MAINTENANCE_INTERVAL_SECONDS=3600
ROUTEOPS_IMPORT_VALIDATION_LEASE_SECONDS=120
ROUTEOPS_IMPORT_VALIDATION_MAX_ATTEMPTS=3
ROUTEOPS_IMPORT_VALIDATION_POLL_SECONDS=5
ROUTEOPS_PLANNING_LEASE_SECONDS=120
ROUTEOPS_PLANNING_MAX_ATTEMPTS=3
ROUTEOPS_PLANNING_POLL_SECONDS=5
ROUTEOPS_PLANNING_MAX_ORDERS=20
ROUTEOPS_PLANNING_MAX_LINES=60
ROUTEOPS_PLANNING_MAX_VEHICLES=6
ROUTEOPS_PLANNING_MAX_MATRIX_CELLS=80
# Backend outside Compose: set ROUTEOPS_IMPORT_STORAGE_ROOT to an ignored private directory.
# Optional local override. The container default is /app/data/synthetic/demo.json.
# ROUTEOPS_DEMO_DATASET=C:/absolute/path/to/backend/data/synthetic/demo.json

POSTGRES_DB=routeops
POSTGRES_USER=routeops
POSTGRES_PASSWORD=
